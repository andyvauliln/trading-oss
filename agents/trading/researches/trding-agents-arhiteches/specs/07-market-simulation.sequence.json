  "cards": [
    {
      "dot": "emerald",
      "title": "Price is produced, not replayed",
      "items": [
        "Orders clear against each other, so the agents move the price they observe",
        "Partial fills and rejections are visible instead of assumed away",
        "Latency, slippage and microstructure become measurable variables"
      ]
    },
    {
      "dot": "violet",
      "title": "Heterogeneity is the experiment",
      "items": [
        "Agents carry different beliefs, information sets and endowments",
        "No shared chat channel: coordination can only happen through the tape",
        "Behavioural biases show up as path dependence in the price series"
      ]
    },
    {
      "dot": "rose",
      "title": "What it is good for",
      "items": [
        "Testing financial theory rather than chasing backtest returns",
        "Stress-testing a strategy against adaptive counterparties",
        "Exposing herding and crowding that a single-agent backtest hides"
      ]
    }
  ]
