        "id": "observe",
        "label": "Private observation",
        "focus": [
          "market",
          "agent_a",
          "agent_b"
        ],
        "note": "Each agent sees the public tape plus its own portfolio, never the other agent's reasoning."
      },
      {
        "id": "matching",
        "label": "Order book and matching",
        "focus": [
          "agent_a",
          "agent_b",
          "book",
          "matcher"
        ],
        "note": "Decisions become typed limit orders that clear against price-time priority, not an assumed fill."
      },
      {
        "id": "settle",
        "label": "Settlement and belief update",
        "focus": [
          "matcher",
          "market",
          "agent_a",
          "agent_b"
        ],
        "note": "Price is an emergent result of the agents' own orders, which is what makes the study a market rather than a backtest."
      }
    ],
