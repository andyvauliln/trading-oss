  "cards": [
    {
      "dot": "cyan",
      "title": "Information fusion, not role split",
      "items": [
        "Trading is framed as fusing numeric, textual and visual evidence",
        "Chart images are a first-class input, not a re-rendering of the numbers",
        "One intelligence module owns perception for the whole agent"
      ]
    },
    {
      "dot": "violet",
      "title": "Two reflections, two questions",
      "items": [
        "Low-level reflection asks why the market moved after an observation",
        "High-level reflection asks why the agent's own trade worked or failed",
        "Retrieval is split per task so trading queries do not pull reflection noise"
      ]
    },
    {
      "dot": "amber",
      "title": "Tools as priors",
      "items": [
        "Classic indicator strategies enter as callable guidance, not hard rules",
        "Expert knowledge constrains the model instead of replacing its reasoning",
        "Every action ships with the reasoning trace that produced it"
      ]
    }
  ]
