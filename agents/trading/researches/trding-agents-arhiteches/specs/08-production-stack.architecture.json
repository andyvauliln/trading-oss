  "cards": [
    {
      "dot": "cyan",
      "title": "Cheap math before expensive inference",
      "items": [
        "Deterministic indicators and regime filters run before the model is called",
        "Confidence scoring narrows the candidate set and cuts inference spend",
        "Point-in-time correctness is enforced at ingestion, not at review time"
      ]
    },
    {
      "dot": "rose",
      "title": "Authority is a contract, not a prompt",
      "items": [
        "An execution authority contract sets instruments, size, drawdown and escalation",
        "A rules engine evaluates it deterministically after the proposal, before the order",
        "Kill switches are tested and every order links to the contract version in force"
      ]
    },
    {
      "dot": "amber",
      "title": "Autonomy is earned",
      "items": [
        "Most desks should ship at approval-workflow autonomy and earn more",
        "Escalation triggers on notional, low confidence, stale data or agent disagreement",
        "The evidence ledger is what makes higher autonomy defensible to a reviewer"
      ]
    }
  ]
