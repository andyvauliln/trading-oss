{
 "_about": "Settings of the project IDE server (apps/project-IDE/server/). Paths are relative to the top of the repository. No secret values here: the keys are named, and their values stay in the keys file on this machine.",
 "repo": "../../..",
 "host": "127.0.0.1",
 "port": 8765,
 "page_dir": "apps/project-IDE/current-ui",
 "page": "file-tree-explorer.html",
 "data": "file-tree.data.json",
 "store_dir": "apps/project-IDE/data/page-store",
 "write_through": true,
 "log_dir": "agents/system/logs/subagents/project-ide-agent",
 "secrets": {
  "file": ".secrets/test/.env",
  "keys": ["ANTHROPIC_API_KEY"]
 },
 "claude": {
  "cwd": "agents/system",
  "model": null,
  "max_turns": 80,
  "max_budget_usd": 3,
  "approval_timeout_s": 900,
  "allow": [
   "Read", "Glob", "Grep", "LS", "Edit", "Write", "MultiEdit", "NotebookEdit", "TodoWrite", "Task", "Agent", "Skill", "WebSearch", "WebFetch",
   "Bash(cd *)", "Bash(python3 *)", "Bash(node *)", "Bash(ls *)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)", "Bash(wc *)", "Bash(grep *)", "Bash(rg *)", "Bash(find *)",
   "Bash(mkdir *)", "Bash(cp *)", "Bash(mv *)", "Bash(jq *)", "Bash(diff *)",
   "Bash(git status*)", "Bash(git ls-files*)", "Bash(git grep*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)", "Bash(git add *)", "Bash(git commit *)", "Bash(git pull*)", "Bash(git fetch*)", "Bash(git merge *)"
  ],
  "ask_owner": ["git push", "git reset", "git rebase", "git checkout --", "git clean", "rm ", "rmdir ", "chmod ", "chown ", "sudo ", "curl ", "wget ", "pip install", "npm install", "kill "],
  "never": [".secrets"]
 }
}
