  "cards": [
    {
      "dot": "cyan",
      "title": "Role decomposition",
      "items": [
        "Four analysts split perception by data modality and run concurrently",
        "Each writes a typed report into shared state rather than a chat transcript",
        "Quick models summarize and fetch; deep models reason and decide"
      ]
    },
    {
      "dot": "violet",
      "title": "Disagreement as a mechanism",
      "items": [
        "Bull and bear researchers are adversarial by construction",
        "A research manager terminates the debate and commits an investment plan",
        "Risky, neutral and safe debators re-argue the trade before approval"
      ]
    },
    {
      "dot": "rose",
      "title": "Why it is auditable",
      "items": [
        "Every decision carries a natural-language rationale chain",
        "Structured documents stop detail loss across agent hops",
        "Realized returns feed a reflection memory the trader recalls later"
      ]
    }
  ]
