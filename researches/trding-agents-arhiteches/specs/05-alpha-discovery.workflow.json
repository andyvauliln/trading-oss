  "cards": [
    {
      "dot": "cyan",
      "title": "The loop, not the model",
      "items": [
        "Hypothesis, executable factor, backtest, critique, repeat",
        "The LLM proposes; deterministic code decides what survives",
        "Search budget and rejected branches are part of the artifact"
      ]
    },
    {
      "dot": "rose",
      "title": "Discipline before performance",
      "items": [
        "Point-in-time data and survivorship handling gate the backtest",
        "Transaction costs and turnover are evaluated, not assumed away",
        "A new factor must be orthogonal to what the book already trades"
      ]
    },
    {
      "dot": "amber",
      "title": "Why it is evolutionary",
      "items": [
        "Experiment memory turns failed trials into generation-time context",
        "Explicit regularization pushes back against factor crowding and decay",
        "Each generation inherits the search process, not just the winners"
      ]
    }
