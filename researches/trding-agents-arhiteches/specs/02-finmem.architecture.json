  "cards": [
    {
      "dot": "cyan",
      "title": "Cognition-shaped memory",
      "items": [
        "Three layers mirror how long different financial facts stay useful",
        "Each layer decays at its own rate instead of one flat context window",
        "Retrieval ranks events by recency, semantic relevancy and importance"
      ]
    },
    {
      "dot": "violet",
      "title": "Character as a parameter",
      "items": [
        "Risk-seeking, risk-averse and self-adaptive personas are explicit inputs",
        "The self-adaptive persona switches on recent realized performance",
        "Professional knowledge is separated from episodic market memory"
      ]
    },
    {
      "dot": "amber",
      "title": "Single agent, no committee",
      "items": [
        "One agent replaces a role-split team; depth comes from memory, not headcount",
        "Cognitive span caps how many memories reach the prompt",
        "Events that preceded profitable trades are promoted to deeper layers"
      ]
    }
